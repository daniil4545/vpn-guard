<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.vpn-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BIN@/vpn-guard</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/vpn-guard.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/vpn-guard.log</string>
</dict>
</plist>
